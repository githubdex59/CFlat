-+}
-+
-+#nav-sync {
-+  position:absolute;
-+  top:0px;
-+  right:0px;
-+  z-index:1;
-+}
-+
-+#nav-sync img {
-+  opacity:0.3;
-+}
-+
-+div.nav-sync-icon {
-+	position: relative;
-+	width: 24px;
-+	height: 17px;
-+	left: -6px;
-+	top: -1px;
-+	opacity: 0.7;
-+	display: inline-block;
-+	background-color: #101826;
-+	border: 1px solid #212F4B;
-+	box-sizing: content-box;
-+}
-+
-+div.nav-sync-icon:hover {
-+	background-color: #1D2A43;
-+	opacity: 1.0;
-+}
-+
-+div.nav-sync-icon.active:after {
-+	content: '';
-+	background-color: #101826;
-+	border-top: 2px solid #4665A2;
-+	position: absolute;
-+	width: 16px;
-+	height: 0px;
-+	top: 7px;
-+	left: 4px;
-+}
-+
-+div.nav-sync-icon.active:hover:after {
-+	border-top: 2px solid #5373B4;
-+}
-+
-+span.sync-icon-left {
-+	position: absolute;
-+	padding: 0;
-+	margin: 0;
-+	top: 3px;
-+	left: 4px;
-+	display: inline-block;
-+	width: 8px;
-+	height: 8px;
-+	border-left: 2px solid #4665A2;
-+	border-top: 2px solid #4665A2;
-+	transform: rotate(-45deg);
-+}
-+
-+span.sync-icon-right {
-+	position: absolute;
-+	padding: 0;
-+	margin: 0;
-+	top: 3px;
-+	left: 10px;
-+	display: inline-block;
-+	width: 8px;
-+	height: 8px;
-+	border-right: 2px solid #4665A2;
-+	border-bottom: 2px solid #4665A2;
-+	transform: rotate(-45deg);
-+}
-+
-+div.nav-sync-icon:hover span.sync-icon-left {
-+	border-left: 2px solid #5373B4;
-+	border-top: 2px solid #5373B4;
-+}
-+
-+div.nav-sync-icon:hover span.sync-icon-right {
-+	border-right: 2px solid #5373B4;
-+	border-bottom: 2px solid #5373B4;
-+}
-+
-+#nav-path ul {
-+  border-top: 1px solid #212F4B;
-+}
-+
-+@media print
-+{
-+  #nav-tree { display: none; }
-+  div.ui-resizable-handle { display: none; position: relative; }
-+}
-+
-+/*---------------------------*/
-+#container {
-+	display: grid;
-+	grid-template-columns: auto auto;
-+	overflow: hidden;
-+}
-+
-+#page-nav {
-+	background: #101826;
-+	display: block;
-+	width: 250px;
-+	box-sizing: content-box;
-+        position: relative;
-+	border-left: 1px solid #212F4B;
-+}
-+
-+#page-nav-tree {
-+	display: inline-block;
-+}
-+
-+#page-nav-resize-handle {
-+  transition: opacity 0.5s ease;
-+  background-color: #283A5D;
-+  opacity:0;
-+  cursor:col-resize;
-+  height:100%;
-+  right:0;
-+  top:0;
-+  width:6px;
-+  position: relative;
-+  z-index: 1;
-+  user-select: none;
-+}
-+
-+#page-nav-resize-handle:after {
-+  content: '';
-+  display: block;
-+  top: 50%;
-+  left: 1px;
-+  width: 2px;
-+  height: 15px;
-+  border-left: 1px solid #4665A2;
-+  border-right: 1px solid #4665A2;
-+  position: absolute;
-+}
-+
-+#page-nav-resize-handle.dragging,
-+#page-nav-resize-handle:hover {
-+  opacity: 1;
-+}
-+
-+#page-nav-contents {
-+  padding: 0;
-+  margin: 0;
-+  display: block;
-+  top: 0;
-+  left: 0;
-+  height: 100%;
-+  width: 100%;
-+  position: absolute;
-+  overflow: auto;
-+  scrollbar-width: thin;
-+  -webkit-overflow-scrolling : touch; /* iOS 5+ */
-+}
-+
-+ul.page-outline,
-+ul.page-outline ul {
-+  text-indent: 0;
-+  list-style: none outside none;
-+  padding: 0 0 0 4px;
-+}
-+
-+ul.page-outline {
-+  margin: 0 4px 4px 6px;
-+}
-+
-+ul.page-outline div.item {
-+  font: 12px 'Lucida Grande',Geneva,Helvetica,Arial,sans-serif;
-+  line-height: 22px;
-+}
-+
-+ul.page-outline li {
-+  white-space: nowrap;
-+}
-+
-+ul.page-outline li.vis {
-+  background-color: #1D2A43;
-+}
-+
-+#container.resizing {
-+  cursor: col-resize;
-+  user-select: none;
-+}
-diff --git a/Doc/html/navtree.js b/Doc/html/navtree.js
-new file mode 100644
