-new file mode 100644
-index 0000000..7e658ef
---- /dev/null
-+++ b/Doc/html/dynsections.js
-@@ -0,0 +1,191 @@
-+/*
-+ @licstart  The following is the entire license notice for the JavaScript code in this file.
-+
-+ The MIT License (MIT)
-+
-+ Copyright (C) 1997-2020 by Dimitri van Heesch
